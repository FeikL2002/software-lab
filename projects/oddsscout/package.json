{
  "name": "oddsscout",
  "version": "9.0.0",
  "private": true,
  "type": "module",
  "description": "A mobile-first, Netlify-ready sportsbook odds comparison app.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run deploy:preview",
    "deploy:preview": "npm run typecheck && npm run lint && npm test && npm run build && npx netlify-cli@latest deploy --build --context deploy-preview --dir=dist --functions=netlify/functions",
    "verify:routes": "node scripts/verify-routes.mjs",
    "test:browser": "npm run test:ui",
    "preview:html": "node scripts/build-preview.mjs",
    "test:ui": "node scripts/browser-qa.mjs",
    "lint": "eslint public server netlify/functions netlify/edge-functions scripts",
    "typecheck": "tsc --noEmit",
    "verify:live": "node scripts/verify-live-preview.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/database-dev": "^1.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "@netlify/identity": "^2.0.0",
    "openai": "^7.34.0"
  }
}
