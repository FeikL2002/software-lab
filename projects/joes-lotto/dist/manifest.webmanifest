{
  "name": "Joe’s Lotto App",
  "short_name": "Joe’s Lotto",
  "lang": "en-US",
  "description": "Joe’s personal Ohio Lottery ticket wallet, barcode scanner, numbers, and nearby stores.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f8f2",
  "theme_color": "#173e33",
  "prefer_related_applications": false,
